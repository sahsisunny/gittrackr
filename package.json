    "fix": "npm run format && npm run lint"
  },
  "dependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^9.20.0",
    "eslint-config-next": "^16.4.6",
    "moment": "^2.31.0",
    "next": "^16.4.6",
    "next-auth": "^4.24.15",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-tsparticles": "^2.12.2",
    "resend": "^6.38.0",
    "sharp": "^0.35.5",
    "tsparticles": "^3.9.1",
    "tsparticles-slim": "^2.12.0"
